# ==============================================================================
# Portfolio Backend Environment Configuration Template
# Copy this file to .env and provide your local/deployment secrets.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
CANONICAL_DOMAIN=amoo-quadri.vercel.app

# CORS & Allowed Origins (comma-separated or single URL)
ALLOWED_ORIGINS=http://localhost:5173,https://amoo-quadri.vercel.app,https://amooquadri.dev
FRONTEND_URL=http://localhost:5173

# Admin Security & Auth
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_TOKEN_SECRET=your_jwt_signing_secret_at_least_32_chars_long
VISITOR_SALT=your_random_salt_for_ip_hashing_at_least_16_chars_long

# AI Assistant Service (Gemini API)
GEMINI_API_KEY=your_google_gemini_api_key

# GitHub Integration
GITHUB_USERNAME=AmooAyomikun
GITHUB_TOKEN=your_github_personal_access_token

# Contact Form & Notifications (Resend API)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Portfolio Contact <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAIL=amooquadri555@gmail.com

# Firebase Firestore (Optional: JSON string or file in backend/firebase-key.json)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
